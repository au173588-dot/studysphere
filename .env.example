# ==============================================================================
# StudySphere Environment Configuration
# Copy this file to `.env.local` and fill in optional credentials as needed.
# Never expose secret keys with NEXT_PUBLIC_ prefixes!
# ==============================================================================

# Public canonical URL of your deployed site (used for sitemap, canonical URLs, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://studysphere.example.org

# Secret key for signing HttpOnly authentication cookies (generate a 32+ byte random hex string in production)
AUTH_SECRET=replace-with-a-long-cryptographically-random-secret-in-production

# Optional: YouTube Data API v3 Key for live YouTube educational channel search
# Without this key, StudySphere searches verified curated YouTube playlists and displays an honest setup status for live YouTube API queries.
YOUTUBE_API_KEY=

# Optional: Transactional Email API Key (e.g., Resend / SendGrid) for delivering contact form & password-reset emails externally.
# When omitted, messages and reset tokens are persisted securely to `/data/store.json` on the server with a clear status notice.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=support@studysphere.example.org
